# Put in the HTTPS server block before the generic location / rule.
location ~* ^/index(?:\.(?:html?|php))?/?$ {
    return 301 /;
}

# nginx normally merges repeated slashes when merge_slashes is on (default).
merge_slashes on;

gzip on;
gzip_vary on;
gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

# Requires ngx_brotli; omit when the module is not installed.
brotli on;
brotli_types text/plain text/css application/javascript application/json application/xml image/svg+xml;
